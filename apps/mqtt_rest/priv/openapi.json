{
  "openapi" : "3.0.1",
  "info" : {
    "contact" : {
      "email" : "krasnop@bellsouth.net"
    },
    "description" : "This is a RESTful API of MQTT server. The API manages user database of MQTT server. See for details https://github.com/alekras/erl.mqtt.server",
    "license" : {
      "name" : "Apache 2.0",
      "url" : "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "title" : "MQTT server API",
    "version" : "2.2.1"
  },
  "externalDocs" : {
    "description" : "Find out more about Erlang MQTT server",
    "url" : "https://github.com/alekras/erl.mqtt.server"
  },
  "servers" : [ {
    "url" : "{protocol}://{server}:{port}/rest",
    "variables" : {
      "protocol" : {
        "default" : "http",
        "enum" : [ "http", "https" ]
      },
      "server" : {
        "default" : "localhost",
        "enum" : [ "lucky3p.com", "localhost" ]
      },
      "port" : {
        "default" : "8080"
      }
    }
  } ],
  "security" : [ {
    "ApiKeyAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Manage user database",
    "externalDocs" : {
      "description" : "Find out more",
      "url" : "http://lucky3p.com"
    },
    "name" : "user"
  }, {
    "description" : "Manage server state and configuration",
    "name" : "server"
  } ],
  "paths" : {
    "/user/login/{user_name}" : {
      "post" : {
        "operationId" : "loginUser",
        "parameters" : [ {
          "description" : "User name",
          "explode" : false,
          "in" : "path",
          "name" : "user_name",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "examples" : {
                "password" : {
                  "summary" : "alex"
                }
              },
              "schema" : {
                "$ref" : "#/components/schemas/User"
              }
            }
          },
          "description" : "User's password in plain text format",
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SuccessLogin"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid request"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "User not found or password is invalid"
          }
        },
        "summary" : "User is trying to log in to server",
        "tags" : [ "user" ]
      }
    },
    "/user/{user_name}" : {
      "delete" : {
        "operationId" : "deleteUser",
        "parameters" : [ {
          "description" : "User name",
          "explode" : false,
          "in" : "path",
          "name" : "user_name",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successfully deleted"
          },
          "204" : {
            "description" : "Already deleted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "User not found"
          }
        },
        "summary" : "Delete user in the database",
        "tags" : [ "user" ]
      },
      "get" : {
        "description" : "Returns a user's password in md5 format and list of roles",
        "operationId" : "getUserInfo",
        "parameters" : [ {
          "description" : "User name",
          "explode" : false,
          "in" : "path",
          "name" : "user_name",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/User"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid user name supplied"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "User not found"
          }
        },
        "summary" : "Get user's information",
        "tags" : [ "user" ]
      },
      "post" : {
        "operationId" : "createNewUser",
        "parameters" : [ {
          "description" : "User name",
          "explode" : false,
          "in" : "path",
          "name" : "user_name",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/User"
              }
            }
          },
          "description" : "User's password in plain text format and roles",
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid request"
          }
        },
        "summary" : "Add a new user to the database",
        "tags" : [ "user" ]
      },
      "put" : {
        "operationId" : "updateUser",
        "parameters" : [ {
          "description" : "User name",
          "explode" : false,
          "in" : "path",
          "name" : "user_name",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/User"
              }
            }
          },
          "description" : "User's name, password in plain text format and roles",
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid request"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "User not found"
          }
        },
        "summary" : "Update an existed user in the database",
        "tags" : [ "user" ]
      }
    },
    "/user/{user_name}/status" : {
      "get" : {
        "description" : "Returns a user connection status",
        "operationId" : "getStatus",
        "parameters" : [ {
          "description" : "User name",
          "explode" : false,
          "in" : "path",
          "name" : "user_name",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConnectionStatus"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid user name supplied"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "User not found"
          }
        },
        "summary" : "Get user connection status",
        "tags" : [ "user" ]
      }
    },
    "/user/status" : {
      "get" : {
        "description" : "Returns a list of user's statuses",
        "operationId" : "getAllStatuses",
        "parameters" : [ {
          "description" : "List of user's names",
          "example" : "alex,sam,john",
          "explode" : false,
          "in" : "query",
          "name" : "users",
          "required" : true,
          "schema" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConnectionStatusList"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid user name supplied"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "User not found"
          }
        },
        "summary" : "Get user connection statuses",
        "tags" : [ "user" ]
      }
    },
    "/user/list" : {
      "get" : {
        "description" : "Returns a list of users roles and connection statuses",
        "operationId" : "getUserList",
        "parameters" : [ {
          "description" : "start index and end index in list of users",
          "example" : "0,100",
          "explode" : false,
          "in" : "query",
          "name" : "indexes",
          "required" : false,
          "schema" : {
            "items" : {
              "type" : "integer"
            },
            "type" : "array",
            "uniqueItems" : false
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserList"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid indexes supplied"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Users not found"
          }
        },
        "summary" : "Get list of users",
        "tags" : [ "user" ]
      }
    },
    "/server/config" : {
      "get" : {
        "description" : "Returns a list of configuration items",
        "operationId" : "getConfig",
        "parameters" : [ {
          "description" : "configuration for Erlang application",
          "example" : "mqtt_common,mqtt_rest",
          "explode" : false,
          "in" : "query",
          "name" : "app",
          "required" : false,
          "schema" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Config"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid argument"
          }
        },
        "summary" : "Get server configuration",
        "tags" : [ "server" ]
      }
    },
    "/server/checksession" : {
      "get" : {
        "description" : "Returns a session object",
        "operationId" : "getSession",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "Successful operation"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Invalid request"
          }
        },
        "summary" : "Get web session status",
        "tags" : [ "server" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "User" : {
        "example" : {
          "password" : "password",
          "roles" : [ "roles", "roles" ]
        },
        "properties" : {
          "password" : {
            "type" : "string"
          },
          "roles" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "password" ],
        "type" : "object"
      },
      "ConnectionStatus" : {
        "example" : {
          "id" : "id",
          "status" : "on"
        },
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "status" : {
            "enum" : [ "on", "off", "notFound" ],
            "type" : "string"
          }
        },
        "required" : [ "id" ],
        "type" : "object"
      },
      "ConnectionStatusList" : {
        "items" : {
          "$ref" : "#/components/schemas/ConnectionStatus"
        },
        "type" : "array"
      },
      "SuccessLogin" : {
        "example" : {
          "success" : true,
          "roles" : [ "roles", "roles" ]
        },
        "properties" : {
          "success" : {
            "type" : "boolean"
          },
          "roles" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "UserStatus" : {
        "example" : {
          "user_name" : "user_name",
          "roles" : [ "roles", "roles" ],
          "status" : "on"
        },
        "properties" : {
          "user_name" : {
            "type" : "string"
          },
          "roles" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "status" : {
            "enum" : [ "on", "off" ],
            "type" : "string"
          }
        },
        "required" : [ "id" ],
        "type" : "object"
      },
      "UserList" : {
        "items" : {
          "$ref" : "#/components/schemas/UserStatus"
        },
        "type" : "array"
      },
      "Application" : {
        "example" : {
          "app" : "app",
          "config" : "{}"
        },
        "properties" : {
          "app" : {
            "type" : "string"
          },
          "config" : {
            "type" : "object"
          }
        },
        "type" : "object"
      },
      "Config" : {
        "items" : {
          "$ref" : "#/components/schemas/Application"
        },
        "type" : "array"
      },
      "Session" : {
        "example" : {
          "user" : "user"
        },
        "properties" : {
          "user" : {
            "type" : "string"
          }
        },
        "required" : [ "user" ],
        "type" : "object"
      },
      "Error" : {
        "example" : {
          "code" : "code",
          "message" : "message"
        },
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "message" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "ApiKeyAuth" : {
        "in" : "header",
        "name" : "authorization",
        "type" : "apiKey"
      }
    }
  }
}
