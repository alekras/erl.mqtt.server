{minimum_otp_vsn, "27"}.

{deps, [
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.10.0"}}},
%%    {cowboy, "2.12.0"},
%%    {ranch, "2.1.0"},
    {jesse, {git, "https://github.com/for-GET/jesse.git", {tag, "1.8.1"}}}
]}.

{erl_opts, [
  no_debug_info, 
  {parse_transform, lager_transform}
]}.
{xref_checks,
 [undefined_function_calls, deprecated_function_calls, deprecated_functions]}.
